# ============================================================
# AI 外贸销售工作台 · .gitignore
# 默认策略 = 公开/分发安全版：敏感信息与业务数据一律不上传
# ============================================================

# —— 敏感信息（绝不上传，含 DeepSeek API Key + 卖方公司信息）——
config.json

# —— 本地业务数据库（含询盘 / 客户 / 跟进记录，可能含真实客户数据）——
#    默认排除。若你是「私有仓库自用」且希望同步当前 44 条询盘数据，
#    请删除下面三行前的 #（即允许 workbench.db 入库）——
# workbench/workbench.db
workbench/*.db
workbench/*.db.*

# —— Python 缓存 / 构建残留 ——
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# —— 运行日志 / 临时输出 ——
*.log
_boot.log
_smoke.log

# —— 个人测试输入与真实询盘样例（公开仓库不带）——
my_inquiry.txt
真实询盘_*.txt

# —— 本地虚拟环境 ——
.venv/
venv/

# —— Codex 本地辅助目录 / 测试输出产物 ——
.agents/
*.out
